        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2329" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>begitu  lalu tautua dia sama sama pergi ke sana.</ANNOTATION_VALUE>
