            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2314" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>do dia tinggal di rumah saja</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2315" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>kemudian do dia melahirkan bayi  di rumah   lalu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2316" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE> Bayi sudah mati</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2317" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>adek tautua  ini dia tidak tahu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2318" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>Do melahirkan bayi baru do dia mati di rumah, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2319" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>ini tautua dia tidak tahu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2320" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>Do punya bayangkan bangkit  baru gedong anak bayi  yang sudah mati itu  sama sama,bawa  jalan ketemu tautua di hutan. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2321" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>sudah ketemu di hutan lalu dia kasih tahu begini.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2322" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>ipar kmu punya kakak bilang ko dengan saya kita dua sama sama pergi ke sana untuk tebang pohon sagu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2323" ANNOTATION_REF="a115">
