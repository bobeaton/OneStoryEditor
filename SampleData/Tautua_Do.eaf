        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2336" ANNOTATION_REF="a216">
                <ANNOTATION_VALUE>jalan turus sampai  kamu sendiri kasih tahu saja. kami jalan turus  sampai kalau sudah  dekat  tunjukkan  bilang  saya ini atau sebut nama  sagu itu ( kata tautua.)</ANNOTATION_VALUE>
