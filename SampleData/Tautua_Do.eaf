        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2308" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Tautua sama Do</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2309" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>turus tautua ini adik dari do punya suami.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2310" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Do dia seorang perempun turus</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2311" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>do ini Tautua punya kaka yang dia kawin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2312" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>baru Tautua ini dia jalan  pagi -pagi sekali dia pergi berburu di hutan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2313" ANNOTATION_REF="a41">
