        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2328" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>sagu tinggi sekali itunya kamu dengan saya jalan sama sama  sampai ketemu sagu itu  baru tebang sama sama ya.</ANNOTATION_VALUE>
