        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2438" ANNOTATION_REF="a1036">
                <ANNOTATION_VALUE>Cerita tentang ini  batas samapai di itu saja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="phraseGloss"
        PARENT_REF="A_phrase-txt-fau" TIER_ID="A_phrase-gls-en">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2439" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>Saya Cerita ini tentang</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2440" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>tautua itu yang saya bicara</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2441" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Tautua sama Do</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2442" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>This Tautua was the younger sibling.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2443" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Do, the woman, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2444" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Tautua's older brother had married (lit. had taken).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2445" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>So Tautua went out hunting early in the morning.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2446" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>Do was pregnant, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2447" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>so he left her at home, </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2448" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>and as she was giving birth to the infant, she died</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2449" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>She died and then</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2450" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE> younger brother Tauta didn't know about it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2451" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>That as she was at home giving birth to the infant,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2452" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>she died, Tautua didn't know.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2453" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>Do (her ghost/zombie) carried (/slung in the baby sling) the (dead) baby and then,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
