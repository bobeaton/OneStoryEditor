    <ANNOTATION><REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a15"><ANNOTATION_VALUE> saya yang panah sosua di tengah jalan di situ.</ANNOTATION_VALUE></REF_ANNOTATION></ANNOTATION>
