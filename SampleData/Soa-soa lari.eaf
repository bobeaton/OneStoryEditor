    <ANNOTATION><REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a59"><ANNOTATION_VALUE>saya punya kain  ( mulai di tarik lagi )</ANNOTATION_VALUE></REF_ANNOTATION></ANNOTATION>
    <ANNOTATION><REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a62"><ANNOTATION_VALUE>saya punya kain mulai  tarik -tarik  dengan kuku di dalam kainnya</ANNOTATION_VALUE></REF_ANNOTATION></ANNOTATION>
