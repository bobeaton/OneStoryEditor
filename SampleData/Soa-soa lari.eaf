    <ANNOTATION><REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a36"><ANNOTATION_VALUE>sudah selesai toki baru kasih tinggalkan. </ANNOTATION_VALUE></REF_ANNOTATION></ANNOTATION>
    <ANNOTATION><REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a39"><ANNOTATION_VALUE>( baiba ) dia yang suruh saya isi  ( sosua )  isi di dalam (  nokenya  )</ANNOTATION_VALUE></REF_ANNOTATION></ANNOTATION>
    <ANNOTATION><REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a46"><ANNOTATION_VALUE>Ia ko sudah jadi bapk ton nanti  saya  isi di (  noke )   </ANNOTATION_VALUE></REF_ANNOTATION></ANNOTATION>
