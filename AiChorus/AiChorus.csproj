    <PackageReference Include="Vulcan.Uczniowie.HelpProvider" Version="1.0.16" />
  </ItemGroup>
  <!-- Encoding-Converters-Core's own build\SharedItems.props (imported via Directory.Build.targets) owns the
       versions of the AI-translator (Google Cloud/OpenAI/Grpc) and related System.* packages, the same as for
       StoryEditor (which shares this project's output folder), so don't also give any of its packages an
       explicit PackageReference above. -->
  <PropertyGroup>
    <UseEcSharedItems>true</UseEcSharedItems>
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEvent>copy $(TargetDir)$(TargetName).* $(SolutionDir)DepDLLs</PostBuildEvent>
  </PropertyGroup>
</Project>
