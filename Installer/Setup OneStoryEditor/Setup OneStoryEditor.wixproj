<Project Sdk="WixToolset.Sdk/6.0.2" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <OutputType>Package</OutputType>
    <OutputName>SetupOneStoryEditor</OutputName>
    <ProjectGuid>015275ee-e5b0-439e-9030-85c8125bf911</ProjectGuid>
    <!-- ICE30: two independently-built, externally-vendored merge modules (ChorusMergeModule and the
         Encoding-Converters-Core package's own EC_40_MM, neither authored in this repo) both bundle their own
         copy of icu.net.dll and both install it to the same INSTALLFOLDER path - a genuine file collision
         between two black-box merge modules this project doesn't control the internals of. First surfaced by
         bumping Encoding-Converters-Core to 0.9.9 (its EC_40_MM.msm's icu.net.dll component changed enough to
         collide with Chorus's own pre-existing one; the two hadn't collided under 0.9.8). Not fixable from
         this side short of patching either vendored merge module - suppressed here rather than left
         unbuildable; both components still install byte-identical files in practice (both merge modules track
         the same nuget-published icu.net build), so the theoretical reference-counting risk ICE30 warns about
         (one component's uninstall removing a file the other still expects) is low. -->
    <SuppressIces>ICE30</SuppressIces>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>EcDistFilesPath=$(EcDistFilesPath)</DefineConstants>
  </PropertyGroup>
  <!-- No explicit <Compile> ItemGroup needed: WixToolset.Sdk auto-globs **/*.wxs by default
       (EnableDefaultCompileItems), and this directory has no stray/dead .wxs file to exclude
       (unlike silconverters' "SEC Setup", which has to opt out of the default glob for that reason). -->
  <ItemGroup>
    <!-- WixUIExtension provides the WixUI_InstallDir dialog set (referenced via <ui:WixUI Id="WixUI_InstallDir" />
         in Product.wxs). WixNetFxExtension is deliberately NOT referenced here: v6.0.2's netfx wixext no longer
         ships the "WIX_IS_NETFRAMEWORK_461_OR_LATER_INSTALLED" PropertyRef (or any NETFRAMEWORK-prefixed
         authoring at all) - the equivalent check is hand-authored directly in Product.wxs instead, so the
         extension package isn't needed. -->
    <PackageReference Include="Encoding-Converters-Core" Version="$(EcCoreVersion)" GeneratePathProperty="true" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
  <Target Name="PostBuildCopy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(SolutionDir)output\$(TargetName)_$(PlatformName)$(TargetExt)" />
  </Target>
  <Target Name="SignBuild">
    <PropertyGroup>
      <MsiFile>$(TargetName)_$(PlatformName)$(TargetExt)</MsiFile>
      <!-- Condition added: a bare reassignment here unconditionally clobbers any SolutionDir already passed in
           (target-scoped PropertyGroup assignments aren't protected from overriding global properties the way a
           static, evaluation-time PropertyGroup is), which broke Setup Bundle OneStoryEditor.wixproj's
           EnsureSignedMsiPayload target explicitly passing SolutionDir when building this project as a nested
           child (see its own comment) - that nested build's MSBuildStartupDirectory is wherever the OUTER build
           started, not the repo root, so BaseBuildDir below resolved to a nonexistent path. Falling back to
           MSBuildStartupDirectory only when SolutionDir isn't already set preserves the original behavior for
           TeamCity's existing direct "-t:SignBuild" invocation (which doesn't pass SolutionDir, and does launch
           msbuild.exe from the repo root) while respecting an explicitly-passed value otherwise. -->
      <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildStartupDirectory)\</SolutionDir>
      <BaseBuildDir>$(SolutionDir)build\</BaseBuildDir>
      <OutputDir>$(SolutionDir)output\</OutputDir>
      <BaseBuildArgs>"$(OutputDir)$(MsiFile)"</BaseBuildArgs>
    </PropertyGroup>
    <Message Text="MsiFile: $(MsiFile), SolutionDir: $(SolutionDir), BaseBuildDir: $(BaseBuildDir), OutputDir: $(OutputDir), BaseBuildArgs: $(BaseBuildArgs), BuildingInsideVisualStudio: $(BuildingInsideVisualStudio), MSBuildStartupDirectory: $(MSBuildStartupDirectory)" />
    <Exec WorkingDirectory="$(BaseBuildDir)" Command="$(BaseBuildDir)buildBaseInstaller.bat $(BaseBuildArgs)" />
  </Target>
</Project>