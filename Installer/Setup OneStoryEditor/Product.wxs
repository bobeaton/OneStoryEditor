<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  
  <Package Name="OneStory Editor 5.6" Language="1033" Version="5.6" Manufacturer="SIL International" UpgradeCode="{92A9B369-3609-4129-A09D-5BB5BBE30AAB}">
    
    <Launch Condition="Privileged" Message="You need to be an administrator to install this product." />
    <Launch Condition="(NOT Version9X) OR (NOT VersionNT OR (VersionNT &gt;= 500))" Message="[ProductName] will only run on Windows 2000 or better. You cannot intall it on this machine." />

    <Icon Id="OneStory.ico" SourceFile="..\..\StoryEditor\OneStory.ico" />
    <Property Id="ARPPRODUCTICON" Value="OneStory.ico" />

    <Property Id="REINSTALLMODE" Value="amus" />
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed." AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Require .NET 4.5+ -->
    <!-- WixToolset.Netfx.wixext no longer ships the "WIX_IS_NETFRAMEWORK_461_OR_LATER_INSTALLED" PropertyRef as
         of v6.0.2 (confirmed: the v6.0.2 wixext DLL contains no NETFRAMEWORK-prefixed properties at all, only
         NGen-scheduling custom actions) - hand-authored below instead, extracted byte-for-byte from the actual
         v3.14.1 WixNetFxExtension.dll's embedded netfx.wixlib (NetFx461.wxs's AppSearch/Property/SetProperty
         rows: RegLocator "SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"\"Release" -> WIXNETFX4RELEASEINSTALLED,
         then WIX_IS_NETFRAMEWORK_461_OR_LATER_INSTALLED = 1 when WIXNETFX4RELEASEINSTALLED >= "#394254"), not
         reconstructed from memory. -->
    <Property Id="WIXNETFX4RELEASEINSTALLED" Secure="yes">
      <RegistrySearch Id="NetFx4ReleaseInstalled" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" />
    </Property>
    <SetProperty Id="WIX_IS_NETFRAMEWORK_461_OR_LATER_INSTALLED" Value="1" After="AppSearch" Condition="WIXNETFX4RELEASEINSTALLED &gt;= &quot;#394254&quot;" />
    <Launch Condition="Installed OR WIX_IS_NETFRAMEWORK_461_OR_LATER_INSTALLED" Message="This application requires .NET Framework 4.6.1 or later. Please install the .NET Framework then run this installer again. (https://www.microsoft.com/en-us/download/details.aspx?id=49981)" />
    
    <Feature Id="Always" Title="Always" Display="hidden" Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="BiblicalTermsComponents" />
      <ComponentGroupRef Id="EcPluginsComponents" />
      <ComponentGroupRef Id="LocDataComponents" />
      <ComponentGroupRef Id="SwordModsComponents" />
      <ComponentGroupRef Id="SwordNetBibleComponents" />
      <ComponentGroupRef Id="ApplicationStartMenuFolderComponents" />
      <ComponentRef Id="MyAppFolder" />
      <MergeRef Id="ChorusMergeModule" />
      <MergeRef Id="AIGuesserMM" />
      <MergeRef Id="EcTranslatorsMM" />
      <MergeRef Id="CcDLLsMM" />
      <MergeRef Id="ClipboardEncConverter" />
      <MergeRef Id="EC_40_MM" />
      <MergeRef Id="ICU_40" />
      <MergeRef Id="SetPath" />
      <MergeRef Id="TECkitDLLsMM" />
    </Feature>

    <PropertyRef Id="MergeModulesFragment" />

    <InstallExecuteSequence>
      <WriteEnvironmentStrings />
    </InstallExecuteSequence>

    <WixVariable Id="WixUILicenseRtf" Value="..\License.rtf" />
    
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <ui:WixUI Id="WixUI_InstallDir" />
    
  </Package>

  <Fragment>
      <StandardDirectory Id="ProgramFilesFolder">
        <Directory Id="SIL" Name="SIL">
          <Directory Id="INSTALLFOLDER" Name="OneStory Editor">
            <Component Id="MyAppFolder" Guid="{F13C74FF-6D0C-41CC-B812-1C992FD2F49E}">
              <CreateFolder />
              <RemoveFile Id="PurgeAppFolder" Name="*.*" On="uninstall" />
            </Component>
            <Directory Id="BiblicalTerms" Name="BiblicalTerms" />
            <Directory Id="EC" Name="EC">
              <Directory Id="Plugins" Name="Plugins" />
            </Directory>
            <Directory Id="LocData" Name="LocData" />
            <Directory Id="SWORD" Name="SWORD">
              <Directory Id="mods.d" Name="mods.d" />
              <Directory Id="modules" Name="modules">
                <Directory Id="texts" Name="texts">
                  <Directory Id="ztext" Name="ztext">
                    <Directory Id="net" Name="net" />
                  </Directory>
                </Directory>
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </StandardDirectory>
      <!-- wix convert mechanically wrapped every recognized standard-directory name it found (including the v3
           structural scaffolding used only to reach StartMenuFolder\Programs) in its own StandardDirectory
           element, nested exactly as the old Directory tree was - which isn't valid: a StandardDirectory
           resolves to a fixed real-world location on its own and can't be nested inside another one. Flattened
           by hand below: WindowsFolder/ProfilesFolder were pure v3 path scaffolding (never real content) and
           are simply dropped; ProgramMenuFolder and DesktopFolder are each their own top-level StandardDirectory,
           exactly as WiX v4+ expects. (SystemFolder was also one of these originally, for the now-removed CRT
           merge module - see MergeModules.wxs - so it isn't declared here at all any more.) -->
      <StandardDirectory Id="ProgramMenuFolder">
        <Directory Id="ApplicationStartMenuFolder" Name="OneStory Editor" />
      </StandardDirectory>
      <StandardDirectory Id="DesktopFolder" />

    </Fragment>

</Wix>
