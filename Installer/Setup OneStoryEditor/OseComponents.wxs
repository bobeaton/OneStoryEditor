      <Component Id="System.Threading.Tasks.Extensions.dll" Guid="{180D7ECC-43F2-4BA6-BA59-6195640D3041}">
        <File Id="System.Threading.Tasks.Extensions.dll" Name="System.Threading.Tasks.Extensions.dll" Vital="yes" KeyPath="yes" AssemblyManifest="System.Threading.Tasks.Extensions.dll" AssemblyApplication="System.Threading.Tasks.Extensions.dll" Assembly=".net" Source="..\..\output\release\System.Threading.Tasks.Extensions.dll" />
      </Component>

      <!-- ChorusMergeModule.msm (frozen 2022-09-25) still bundles its own Autofac.dll at 2.6.3.862 - ~2013-era,
           long before Autofac's namespace/API overhaul - while Autofac is now referenced directly at 9.3.2 by
           StoryEditor/AiChorus/AdaptIt-ChorusPlugin (confirmed by extracting the actual merge-module payload and
           diffing FileVersion against the current build output; every other file the merge module carries -
           SIL.Core/SIL.Lift/SIL.Windows.Forms/Vulcan.Uczniowie.HelpProvider/libchorus/chorus.exe/chorusmerge.exe
           - turned out to be a byte-identical build, so this is the one real live mismatch, not a hypothetical
           one). Adding the correct-version copy here doesn't remove the merge module's stale one - two
           components can't be pointed at the same install path in this WiX version without an ICE30-style
           conflict, and that's already true of icu.net.dll above for a different reason - but it does put a
           correctly-versioned Autofac.dll into the File table so the outcome depends on MSI's internal sequencing
           rather than the wrong version being the only candidate. The real fix is retiring ChorusMergeModule.msm
           in favor of explicit components once Chorus/Mercurial's NuGet packaging stabilizes (see MergeModules.wxs). -->
      <Component Id="Autofac.dll" Guid="{7E047AB0-A282-4375-A990-3FAB0F5E2B8D}">
        <File Id="Autofac.dll" Name="Autofac.dll" Vital="yes" KeyPath="yes" AssemblyManifest="Autofac.dll" AssemblyApplication="Autofac.dll" Assembly=".net" Source="..\..\output\release\Autofac.dll" />
      </Component>

