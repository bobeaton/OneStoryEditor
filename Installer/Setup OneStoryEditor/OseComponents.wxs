<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <Component Id="AdaptItChorusPlugin.dll" Guid="{DE4093EA-7731-4B1B-BCA7-254F717DDCC7}">
        <File Id="AdaptItChorusPlugin.dll" Name="AdaptIt-ChorusPlugin.dll" Vital="yes" KeyPath="yes" AssemblyManifest="AdaptItChorusPlugin.dll" AssemblyApplication="AdaptItChorusPlugin.dll" Assembly=".net" Source="..\..\output\release\AdaptIt-ChorusPlugin.dll" />
      </Component>
      <Component Id="AiChorus.exe" Guid="{87538C01-6CCA-490E-88AC-020311E17332}">
        <File Id="AiChorus.exe" Name="AiChorus.exe" Vital="yes" KeyPath="yes" AssemblyManifest="AiChorus.exe" AssemblyApplication="AiChorus.exe" Assembly=".net" Source="..\..\output\release\AiChorus.exe">
          <!--this doesn't really do anything in the program menu..ai
                <Shortcut Id="AiChorus.exe" Directory="ApplicationStartMenuFolder" Name="Chorus Project Application" Description="Can be used to edit *.cpc files to manage all OneStory and AdaptIt projects used by OneStory Editor"
                      IconIndex="0" Show="normal" WorkingDirectory="INSTALLFOLDER" Arguments="\e" Advertise="no" />-->
        </File>
        <File Id="chorus.ico" Name="chorus.ico" Source="..\..\AiChorus\Resources\chorus.ico" />

        <!-- App Paths to support Start,Run -> "SIL\OneStoryEditor" -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\AiChorus.exe" Value="[!AiChorus.exe]" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\AiChorus.exe" Name="Path" Value="[INSTALLFOLDER]" Type="string" />

        <!-- Extend to the "open with" list + Win7 jump menu pinning  -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Applications\AiChorus.exe\SupportedTypes" Name=".cpc" Value="Chorus Project Editor File" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Applications\AiChorus.exe\shell\open" Name="Chorus project config file" Value="Chorus Project Editor File" Type="string" />

        <!-- ChorusProject.Document ProgID -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\ChorusProject.Document" Name="Chorus project config file" Value="Chorus Project Editor File" Type="string" />
        <ProgId Id="ChorusProject.Document" Description="The configuration tool for Chorus projects" Icon="chorus.ico" Advertise="no">
          <Extension Id="cpc">
            <Verb Id="open" Command="Open with Chorus Project Editor" TargetFile="AiChorus.exe" Argument="/f &quot;%1&quot;" />
            <MIME Advertise="no" ContentType="application/cpc" Default="yes" />
          </Extension>
        </ProgId>

        <!-- Optional: add an 'Synchronize' to 'right click' even when not associated -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.cpc\shell\sync.AiChorus.exe" Value="Send/Receive (Synchronize) Chorus Projects" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.cpc\shell\sync.AiChorus.exe\command" Value="&quot;[INSTALLFOLDER]AiChorus.exe&quot; /s &quot;%1&quot;" Type="string" />
      </Component>
      <Component Id="AiChorus.exe.config" Guid="{3BE59DB2-4E87-402F-A192-608071E02B5B}">
        <File Id="AiChorus.exe.config" Name="AiChorus.exe.config" KeyPath="yes" Source="..\..\output\release\AiChorus.exe.config" />
      </Component>
      <Component Id="AiChorus.pdb" Guid="{BFBD6A28-2CF1-4C57-B32A-B1B2A4F9194A}">
        <File Id="AiChorus.pdb" Name="AiChorus.pdb" KeyPath="yes" Source="..\..\output\release\AiChorus.pdb" />
      </Component>
