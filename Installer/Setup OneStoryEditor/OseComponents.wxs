      <Component Id="StoryEditor.exe" Guid="{F6A646DC-50AB-4CB7-A954-12A504791F25}">
        <File Id="StoryEditor.exe" Name="StoryEditor.exe" Vital="yes" KeyPath="yes" AssemblyManifest="StoryEditor.exe" AssemblyApplication="StoryEditor.exe" Assembly=".net" Source="..\..\output\release\StoryEditor.exe">
          <Shortcut Id="StoryEditor.exe.Desktop" Directory="DesktopFolder" Name="OneStory Editor" Description="OneStory Editor" IconIndex="0" Show="normal" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
          <Shortcut Id="StoryEditor.exe.StartMenu" Directory="ApplicationStartMenuFolder" Name="OneStory Editor" Description="OneStory Editor" IconIndex="0" Show="normal" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
        </File>
        <File Id="OneStory.ico" Name="OneStory.ico" Source="..\..\StoryEditor\OneStory.ico" />

        <!-- App Paths to support Start,Run -> "SIL\OneStoryEditor" -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\StoryEditor.exe" Value="[!StoryEditor.exe]" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\StoryEditor.exe" Name="Path" Value="[INSTALLFOLDER]" Type="string" />

        <!-- Extend to the "open with" list + Win7 jump menu pinning  -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Applications\StoryEditor.exe\SupportedTypes" Name=".onestory" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Applications\StoryEditor.exe\shell\open" Name="OneStory Editor" Value="OneStory Editor" Type="string" />

        <!-- OneStoryEditor.Document ProgID -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\OneStoryEditor.Document" Name="OneStory Editor" Value="OneStory Editor Project File" Type="string" />
        <ProgId Id="OneStoryEditor.Document" Description="OneStory Editor Project File" Icon="OneStory.ico" Advertise="no">
          <Extension Id="onestory">
            <Verb Id="open" Command="Open with OneStory Editor" TargetFile="StoryEditor.exe" Argument="&quot;%1&quot;" />
            <MIME Advertise="no" ContentType="application/onestory" Default="yes" />
          </Extension>
        </ProgId>

        <!-- Optional: add an 'Edit with onestory' to 'right click' even when not associated -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.onestory\shell\edit.StoryEditor.exe" Value="Edit with OneStory Editor" Type="string" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\.onestory\shell\edit.StoryEditor.exe\command" Value="&quot;[INSTALLFOLDER]StoryEditor.exe&quot; &quot;%1&quot;" Type="string" />
        <RemoveFolder Id="ApplicationStartMenuFolder" On="uninstall" />
      </Component>
      <Component Id="StoryEditor.exe.config" Guid="{0C9A4072-A9CD-4084-846D-77CAD54A98D7}">
