<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
	<Bundle Name="$(var.ApplicationName) $(var.TruncatedVersion)" Version="$(var.VersionNumber)" UpgradeCode="$(var.UpgradeCode)" Tag="$(var.ApplicationName)" IconSourceFile="Installer.ico" Copyright="Copyright © $(var.Year), $(var.Manufacturer)" Manufacturer="$(var.Manufacturer)">

    <bal:Condition Message="XP is no longer supported." Condition="(VersionNT &gt;= v6.0)" />
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseFile="..\License.rtf" Theme="rtfLicense" />
    </BootstrapperApplication>

    <WixVariable Id="WixStdbaLicenseUrl" Value="..\License.rtf" />
    <WixVariable Id="WixStdbaLogo" Value="bundle_background.bmp" />
    <WixVariable Id="WixStdbaThemeXml" Value="BundleTheme.xml" />
    <WixVariable Id="WixStdbaThemeWxl" Value="BundleTheme.wxl" />
    <Chain>
      <PackageGroupRef Id="NetFx48Web" />
      <PackageGroupRef Id="redist_vc15to19" />
      <RollbackBoundary />
      <PackageGroupRef Id="AppPackageGroup" />
    </Chain>

  </Bundle>

  <?if $(var.Platform) = x64 ?>
  <?define msiFilename = "SetupOneStoryEditor_x64.msi" ?>
  <?else?>
  <?define msiFilename = "SetupOneStoryEditor_x86.msi" ?>
  <?endif?>

  <Fragment Id="AppFragment">
    <PackageGroup Id="AppPackageGroup">
      <!-- DisplayInternalUI="yes" (v3) was dropped from core in WiX v4 and replaced by the bal extension's
           bal:DisplayInternalUICondition, which is confirmed to work with WixStandardBootstrapperApplication
           (used here). WixBundleAction = 6 is BOOTSTRAPPER_ACTION_INSTALL, so the MSI's own WixUI_InstallDir
           wizard (authored in "Setup OneStoryEditor"/Product.wxs) surfaces on top of the bundle during a fresh
           install; repair/modify/uninstall still go through Burn's own (simpler) UI. The condition is evaluated
           at plan time, so it must reference the bundle-level WixBundleAction variable, not a package-level
           action. Same fix already applied in the sibling silconverters repo. -->
      <MsiPackage Id="AppMsiPackage" DisplayName="$(var.ApplicationName) $(var.VersionNumber)" ForcePerMachine="yes" InstallCondition="1" SourceFile="$(var.SolutionDir)output\$(var.msiFilename)" Visible="yes" Vital="yes" bal:DisplayInternalUICondition="WixBundleAction = 6">

      </MsiPackage>
    </PackageGroup>

  </Fragment>

  <!-- .NET 4.8 -->
  <?define NetFx48MinRelease = 528049 ?>
  <?define NetFx48WebLink = https://download.visualstudio.microsoft.com/download/pr/2d6bb6b2-226a-4baa-bdec-798822606ff1/9b7b8746971ed51a1770ae4293618187/ndp48-web.exe ?>
  <!-- Size/Hash below are for the exact file currently served at NetFx48WebLink (verified 2026-08-19: HTTP
       Content-Length + a real SHA512 computed over the downloaded bytes). WiX v6's Burn engine hashes
       ExePackagePayload with SHA512 (v3's Payload/@Hash was SHA256/SHA1) - re-verify both values if the
       download URL ever needs to change, or if Burn starts rejecting the download with a hash-mismatch error. -->
  <?define NetFx48WebSize = 1439328 ?>
  <?define NetFx48WebHash = 642721C60D52051C7F3434D8710FE3406A7CFE10B2B39E90EA847719ED1697D7C614F2DF44AD50412B1DF8C98DD78FDC57CA1D047D28C81AC158092E5FB18040 ?>

  <Fragment>
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Net Framework Setup\NDP\v4\Full" Value="Release" Variable="Netfx4FullRelease" />
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Net Framework Setup\NDP\v4\Full" Value="Release" Variable="Netfx4x64FullRelease" Bitness="always64" />
    <WixVariable Id="NetFx48OrLaterDetectCondition" Overridable="yes" Value="(Netfx4FullRelease &gt;= $(var.NetFx48MinRelease)) AND (NOT VersionNT64 OR (Netfx4x64FullRelease &gt;= $(var.NetFx48MinRelease)))" />
    <WixVariable Id="NetFx48WebPackageDirectory" Value="redist\" Overridable="yes" />

    <!-- WixToolset.Netfx.wixext no longer ships a prebuilt "NetFx48Web" PackageGroup as of v6.0.2 (confirmed:
         the v6.0.2 wixext DLL contains no PackageGroup/DotNetFramework authoring at all, only NGen-scheduling
         custom actions) - the old v3 NetFxExtension.wixlib's NetFx48Web fragment is hand-authored here instead,
         following the same shape (and the same fix already applied in the sibling silconverters repo).
         DetectCondition must dereference the WixVariable with !(wix.X): a bare "NetFx48OrLaterDetectCondition" is
         evaluated by Burn as the name of an (undefined) Burn variable, which is always false, so .NET 4.8 was
         re-downloaded and re-run on every install even with 4.8+ already present (seen in a 2026-09-26 VM log
         with Release=528372). The old InstallCondition had the same problem and is redundant with the
         DetectCondition anyway (an undetected package is installed by default), so it was dropped.
         Cache must be "remove", not "keep": Burn acquires (i.e. downloads) a Cache="keep" package into the package
         cache whenever it's planned Present - even when it was detected as already installed and so won't be
         run - so every install hit the network for ndp48-web.exe, and on a machine that couldn't reach
         download.visualstudio.microsoft.com the (Vital) download failure aborted the whole install before the MSI
         ever ran (0x80072ee7, seen in a 2026-09-29 silconverters log with Release=533325). "remove" only acquires
         it when it actually needs to be installed. -->
    <PackageGroup Id="NetFx48Web">
      <ExePackage Id="NetFx48WebExe"
                  Cache="remove"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  Protocol="netfx4"
                  InstallArguments="/q /norestart /ChainingPackage &quot;[WixBundleName]&quot;"
                  RepairArguments="/q /norestart /repair /ChainingPackage &quot;[WixBundleName]&quot;"
                  UninstallArguments="/uninstall /q /norestart /ChainingPackage &quot;[WixBundleName]&quot;"
                  DetectCondition="!(wix.NetFx48OrLaterDetectCondition)">
        <ExePackagePayload Name="!(wix.NetFx48WebPackageDirectory)ndp48-web.exe"
                            DownloadUrl="$(var.NetFx48WebLink)"
                            Size="$(var.NetFx48WebSize)"
                            Hash="$(var.NetFx48WebHash)" />
      </ExePackage>
    </PackageGroup>
  </Fragment>

  <?if $(sys.BUILDARCH)="x86"?>
  <!-- VC++ runtime: this used to come in via the Microsoft_VC142_CRT_x86.msm merge module (vendored in
       ..\ExternalMergeModules, referenced from the MSI's Product.wxs/MergeModules.wxs) plus a separately
       remote-downloaded "VC 2015-2019" ExePackage here in the bundle - two different sources of the same
       runtime, and the merge module was a stale v142 (VS2019) build even though the actual native EcDistFiles
       binaries are built with the v143 (VS2022) toolset. Microsoft has also deprecated the merge-module
       distribution model for the VC++ runtime since VS2019: a merge module freezes the runtime DLLs into the
       MSI's own file table at build time, so they can never receive servicing via Windows Update. Fixed the
       same way as the sibling silconverters repo: the CRT MergeRef was removed from Product.wxs's Feature (and
       the Merge definition from MergeModules.wxs), and this ExePackage is now the sole source of the runtime,
       vendored locally (Redist\vc_redist.x86.exe, copied from this machine's VS2022 install's
       VC\Redist\MSVC\v143\ folder, file version 14.44.35211.0) and embedded in the bundle rather than
       downloaded, to avoid the hash-drift problem documented for NetFx48Web above - Microsoft is known to
       change hosted redist files without notice, and a stale pinned hash breaks the bundle for every user
       until someone re-verifies it. Detection follows the sillsdev/genericinstaller Bundle.wxs convention: a
       bare "Installed" registry value under the runtime's Runtimes\X86 key is treated as good enough (the VC++
       runtime is serviced in place by Windows Update once installed, so this isn't pinned to the exact
       14.44.35211 build vendored here). NOT verified end-to-end on a machine lacking the VC++ runtime (this
       dev machine already has it installed, so only the "already present, skip" path was exercised) -
       flagged for a real clean-VM pass, same as NetFx48Web. -->
  <Fragment>
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X86" Variable="CPP2017Redist" Value="Installed" Result="value" />
    <PackageGroup Id="redist_vc15to19">
      <ExePackage Id="vc17" Cache="remove" PerMachine="yes" Vital="yes" Permanent="yes" DetectCondition="CPP2017Redist" InstallArguments="/install /quiet /norestart" RepairArguments="/repair /quiet /norestart" UninstallArguments="/uninstall /quiet /norestart">
        <ExePackagePayload Name="vc_redist.x86.exe" SourceFile="Redist\vc_redist.x86.exe" />
      </ExePackage>
    </PackageGroup>
  </Fragment>
  <?elseif $(sys.BUILDARCH)="x64"?>
  <!-- 64bit  VC++ redistributable download section -->
  <!-- When updating or adding a redistributable you can generate the RemotePayload with the WIX's heat tool -->
  <!-- e.g. "%WIX%\bin\heat" payload C:\fwroot\fw\PatchableInstaller\libs\vcredist_2008_x64.exe -o c:\Repositories\fw\PatchableInstaller\VC2008Frag.wxs -->
  <?define VC15to19RedistWebLink = https://download.visualstudio.microsoft.com/download/pr/36e45907-8554-4390-ba70-9f6306924167/97CC5066EB3C7246CF89B735AE0F5A5304A7EE33DC087D65D9DFF3A1A73FE803/VC_redist.x64.exe ?>
  <Fragment>
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64" Variable="CPP2017Redist64" Value="Installed" Result="value" Bitness="always64" />
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64" Variable="CPP2017Redist32" Value="Installed" Result="value" Bitness="always32" />
    <PackageGroup Id="redist_vc15to19">
      <!-- Hash re-verified 2026-08-19 the same way as the x86 payload above. Note: this x64 branch has no
           corresponding platform in StoryEditor 2017.sln (x86-only solution) and has never actually been built
           or installed - flagging per the same "not verified end-to-end" standard used elsewhere for
           unexercised code paths. -->
      <ExePackage Id="vc17" Cache="remove" PerMachine="yes" Vital="yes" Permanent="yes" DetectCondition="(CPP2017Redist32) OR (CPP2017Redist64)" InstallArguments="/quiet /norestart">
        <ExePackagePayload Size="25169400" Version="14.29.30040.0" ProductName="Microsoft Visual C++ 2015-2019 Redistributable (x64) - 14.28.29914" Description="Microsoft Visual C++ 2015-2019 Redistributable (x64) - 14.28.29914" Hash="35BA410637878D5A9DEDE02D92DF9747CD809B7F0894227B2CCED3B21568CB2D485CA4DFF5C756248DE2CA820A560B18AF60C3C3E8CA74AD69E9E2B355424897" Name="vc_redist.x64.exe" DownloadUrl="$(var.VC15to19RedistWebLink)" />
        <ExitCode Value="1638" Behavior="success" />
        <!-- Don't fail if newer version is installed -->
      </ExePackage>
    </PackageGroup>
  </Fragment>
  <?else?>
  <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
  <?endif?>

</Wix>
