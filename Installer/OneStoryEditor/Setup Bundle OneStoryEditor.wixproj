<Project Sdk="WixToolset.Sdk/6.0.2" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>f9469b39-b401-4a89-a144-f3cc753fc843</ProjectGuid>
    <OutputName>SetupOneStoryEditor_5.6</OutputName>
    <OutputType>Bundle</OutputType>
    <SolutionDir>$(MSBuildStartupDirectory)\</SolutionDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);ApplicationName=OneStory Editor;SafeApplicationName=OneStoryEditor;TruncatedVersion=5.6;VersionNumber=5.6.0.0;UpgradeCode=92A9B369-3609-4129-A09D-5BB5BBE30AAB;Year=2026;Manufacturer=SIL International;EcDistFilesPath=$(EcDistFilesPath)</DefineConstants>
  </PropertyGroup>
  <!-- No explicit <Compile>/<EmbeddedResource> ItemGroup needed for Bundle.wxs/BundleTheme.wxl:
       WixToolset.Sdk auto-globs **/*.wxs and **/*.wxl by default. -->
  <ItemGroup>
    <Content Include="..\License.rtf">
      <Link>License.rtf</Link>
    </Content>
    <Content Include="BundleTheme.xml" />
    <Content Include="bundle_background.bmp" />
    <Content Include="Redist\vc_redist.x86.exe" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Encoding-Converters-Core" Version="$(EcCoreVersion)" GeneratePathProperty="true" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="6.0.2" />
  </ItemGroup>
  <!-- Confirmed via a real 2026-09-30 TeamCity log: the solution-wide build compiles Setup OneStoryEditor.wixproj
       (producing an unsigned MSI) and then this Bundle project (embedding that still-unsigned MSI as its
       MsiPackage payload, per Bundle.wxs's SourceFile="$(var.SolutionDir)output\SetupOneStoryEditor_x86.msi") -
       all before either project's separate SignBuild target ever runs. Signing the MSI afterward only re-signs
       the loose standalone copy sitting in output\; the copy already embedded in this bundle's own container was
       frozen at build time and never gets replaced, so the bundle's outer exe and detached engine end up
       correctly signed while the MSI riding inside it ships unsigned (verified: signtool finds no signature on
       the MSI extracted back out of a real signed bundle). Fixed here rather than in CI config, since CI
       orchestration (TeamCity today, possibly GitHub Actions later) shouldn't have to know about a dependency
       that's really this project's own to declare: force the MSI project to fully build AND sign before this
       project's own Build starts, so whatever ends up embedded is always the already-signed file. Release-only -
       a local Debug build of just this project shouldn't require signing credentials to be present. -->
  <Target Name="EnsureSignedMsiPayload" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
    <!-- SolutionDir passed explicitly: Setup OneStoryEditor.wixproj's own SignBuild target unconditionally
         redefines SolutionDir from $(MSBuildStartupDirectory), which only happens to be the repo root when that
         project is built directly (TC launches msbuild.exe from the repo root for each of its per-project
         steps); built as a nested child project from here, MSBuildStartupDirectory instead reflects
         wherever THIS outer build was launched from. Passing SolutionDir as a global property here takes
         precedence over that unconditional in-target reassignment (global properties can't be overwritten by a
         plain static PropertyGroup in the same project), so the nested build resolves build\ and output\
         correctly regardless of where the outer build started. -->
    <MSBuild Projects="..\Setup OneStoryEditor\Setup OneStoryEditor.wixproj" Targets="Build;SignBuild" Properties="Configuration=$(Configuration);Platform=$(Platform);SolutionDir=$(SolutionDir)" />
  </Target>
  <Target Name="PostBuildCopy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(SolutionDir)output\$(TargetName)_$(PlatformName)$(TargetExt)" />
  </Target>
  <Target Name="SignBuild">
    <PropertyGroup>
      <ExeFile>$(TargetName)_$(PlatformName)$(TargetExt)</ExeFile>
      <BaseBuildDir>$(SolutionDir)build\</BaseBuildDir>
      <OutputDir>$(SolutionDir)output\</OutputDir>
      <!-- wix.exe from the WixToolset.Sdk package (net472 layout, i.e. when run under full-framework MSBuild.exe)
           is used to detach/reattach the bundle engine for signing, so the build agent doesn't need WiX v3's
           insignia.exe on its PATH. -->
      <WixExe>$(WixBinDir)x86\wix.exe</WixExe>
      <BaseBuildArgs>"$(OutputDir)$(ExeFile)" UseInsignia "$(WixExe)"</BaseBuildArgs>
    </PropertyGroup>
    <Error Condition="!Exists('$(WixExe)')" Text="wix.exe not found at '$(WixExe)'; can't detach/reattach the bundle engine for signing." />
    <Message Text="ExeFile: $(ExeFile), SolutionDir: $(SolutionDir), BaseBuildDir: $(BaseBuildDir), OutputDir: $(OutputDir), BaseBuildArgs: $(BaseBuildArgs), BuildingInsideVisualStudio: $(BuildingInsideVisualStudio), MSBuildStartupDirectory: $(MSBuildStartupDirectory)" />
    <Exec WorkingDirectory="$(BaseBuildDir)" Command="$(BaseBuildDir)buildBaseInstaller.bat $(BaseBuildArgs)" />
  </Target>
</Project>