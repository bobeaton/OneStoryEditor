<Project>
  <PropertyGroup>
    <!-- The one place to change the Encoding-Converters-Core version: every ec-core PackageReference uses this, and
         Directory.Build.targets uses it to find that package's build\SharedItems.props. (That path can't come from
         the package's own EcDistFilesPath property, since NuGet skips package imports while restoring.) -->
    <EcCoreVersion>1.0.2</EcCoreVersion>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
    <EcSharedItemsProps>$(NuGetPackageRoot)encoding-converters-core\$(EcCoreVersion)\build\SharedItems.props</EcSharedItemsProps>
  </PropertyGroup>
</Project>
