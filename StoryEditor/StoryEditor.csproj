  <ItemGroup>
    <!-- SDK-style default item globbing picks these files up as plain "None" items, but - unlike the old
         csproj's explicit <Content>/<None> entries - doesn't carry CopyToOutputDirectory along for the ride.
         These whole data-file trees (WiX's OseComponents.wxs/BiblicalTermComponents.wxs source every one of
         them straight out of ..\output\Release) need it added back via Update, not re-declared via Include
         (which would duplicate the already-globbed items). Confirmed against the original committed csproj's
         full explicit file list, same method used to confirm the deleted dead-code files earlier. -->
    <None Update="BiblicalTerms\**;LocData\**;SWORD\**;Toolbox\**;html\**;js\**;LanguageCodes.tab;StageTransitions.xml;StageTransitionsId.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
