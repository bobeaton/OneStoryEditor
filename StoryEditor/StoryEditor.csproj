<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x86</Platforms>
    <ProjectGuid>{EE63B2ED-1488-491F-990A-3FA16E2DB135}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OneStoryProjectEditor</RootNamespace>
    <AssemblyName>StoryEditor</AssemblyName>
    <ApplicationIcon>OneStory.ico</ApplicationIcon>
    <GenerateManifests>false</GenerateManifests>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SignAssembly>false</SignAssembly>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <!-- SDK-style doesn't copy a referenced package's .pdb to output by default the way the old
         packages.config-based project did (only the .dll); WiX's OseComponents.wxs expects SendGrid's
         alongside its dll, confirmed via a real build error. (SendGrid's sibling .xml doc-comment file has
         the same gap with no equally simple opt-in switch - not worth chasing for a file with zero runtime
         effect; dropped from OseComponents.wxs instead.) -->
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\output\$(Configuration)</OutputPath>
    <DefineConstants>TRACE;DEBUG;TurnOnKeyboarding</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>..\output\$(Configuration)</OutputPath>
    <DefineConstants>TRACE;UsingHtmlDisplayForStoryBt</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <!-- These don't resolve via plain PackageReference (non-standard package shapes - native EcDistFiles
         binaries resolved by ProgID at runtime, or DLLs sitting outside any packages\ folder entirely under
         DepDLLs, or the machine-wide mshtml PIA) - same pattern already used throughout this solution
         (see ClipboardEC.csproj in the sibling silconverters repo for the identical EcDistFiles precedent). -->
    <Reference Include="AIGuesserEC">
      <HintPath>$(EcDistFilesPath)\win-$(Platform)\native\AIGuesserEC.dll</HintPath>
    </Reference>
    <Reference Include="CcEC">
      <HintPath>$(EcDistFilesPath)\win-$(Platform)\native\CcEC.dll</HintPath>
    </Reference>
    <Reference Include="EcTranslators">
      <HintPath>$(EcDistFilesPath)\win-$(Platform)\native\EcTranslators.dll</HintPath>
    </Reference>
    <Reference Include="CSSword">
      <HintPath>..\DepDLLs\CSSword.dll</HintPath>
    </Reference>
    <Reference Include="HtmlEditor, Version=7.0.100.5147, Culture=neutral, processorArchitecture=x86">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\DepDLLs\HtmlEditor.dll</HintPath>
    </Reference>
    <Reference Include="NetLoc, Version=7.0.100.5030, Culture=neutral, processorArchitecture=x86">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\DepDLLs\NetLoc.dll</HintPath>
    </Reference>
    <Reference Include="NetMAPI">
      <HintPath>..\DepDLLs\NetMAPI.dll</HintPath>
    </Reference>
    <Reference Include="ParatextShared, Version=7.0.100.5029, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\DepDLLs\ParatextShared.dll</HintPath>
    </Reference>
    <Reference Include="SharedScrUtils, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\DepDLLs\SharedScrUtils.dll</HintPath>
    </Reference>
    <Reference Include="Utilities, Version=7.0.100.5029, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\DepDLLs\Utilities.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.mshtml, Version=7.0.3300.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <HintPath>C:\Program Files (x86)\Microsoft.NET\Primary Interop Assemblies\Microsoft.mshtml.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- KeymanLegacyBundle ships its DLLs directly under lib\ with no TFM subfolder, which plain
         PackageReference asset selection doesn't reliably pick up - explicit HintPath via the generated
         package-path property instead (see the Keyman10Interop/StoryEditor.exe launch-failure fix earlier:
         EmbedInteropTypes was removed here for the same reason - it suppresses Copy-Local regardless of an
         explicit Private override, and these two DLLs are genuinely needed at runtime, not just embeddable
         COM interop types). -->
    <Reference Include="Keyman10Interop">
      <HintPath>$(PkgKeymanLegacyBundle)\lib\Keyman10Interop.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Keyman7Interop">
      <HintPath>$(PkgKeymanLegacyBundle)\lib\Keyman7Interop.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="KeymanLink">
      <HintPath>$(PkgKeymanLegacyBundle)\lib\KeymanLink.dll</HintPath>
    </Reference>
  </ItemGroup>
