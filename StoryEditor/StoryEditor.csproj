  <!-- SharedItems.props centralizes the AI-translator (Google Cloud/OpenAI/Grpc) package versions used by
       EcTranslators-facing code in this project; imported last so it doesn't fight this project's own
       explicit PackageReference versions above for anything overlapping. -->
  <Import Project="$(MSBuildThisFileDirectory)..\SharedItems.props" Condition="Exists('$(MSBuildThisFileDirectory)..\SharedItems.props')" />
  <!-- Restored verbatim from the original (pre-SDK-style) csproj - dropped by accident during the SDK-style
       rewrite, only noticed once a genuinely clean rebuild (rather than one riding on years-old leftover
       output\Release\* files) exposed the gap via the WiX installer's "file not found" errors. Populates
       output\Release with the Mercurial/MercurialExtensions trees (SIL.Chorus.Mercurial's own package targets,
       auto-imported via PackageReference, already stage these to $(SolutionDir)Mercurial -
       $(SolutionDir)MercurialExtensions; this step is what additionally gets them into this project's own
       output folder, next to the exe) and the Encoding-Converters-Core package's native/redist trees
       (win-x86\native\*, redist\* - includes the EC\Plugins\*.xml plugin descriptors and Help\*.htm files the
       installer also sources from here). -->
  <PropertyGroup>
    <PreBuildEvent>xcopy /S /Y /I "$(SolutionDir)Mercurial" "$(SolutionDir)output\$(Configuration)\mercurial"
xcopy /S /Y /I "$(SolutionDir)MercurialExtensions" "$(SolutionDir)output\$(Configuration)\MercurialExtensions"
xcopy /y "$(EcDistFilesPath)\win-x86\native\*.*" "$(SolutionDir)output\$(Configuration)\"
xcopy /s /y "$(EcDistFilesPath)\redist\*.*" "$(SolutionDir)output\$(Configuration)\"</PreBuildEvent>
  </PropertyGroup>
